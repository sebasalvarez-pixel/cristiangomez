# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API — Meta Business > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=un-texto-secreto-que-tu-inventes

# URL pública del sitio (usada en los links de WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto para proteger el endpoint de recordatorios (Vercel Cron lo llama con este header)
CRON_SECRET=otro-texto-secreto-que-tu-inventes
